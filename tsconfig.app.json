{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@bindings/firewall": ["src/bindings/trustline-firewall/src"],
      "@bindings/payment-forwarder": ["src/bindings/payment-forwarder/src"],
      "@bindings/ve": ["src/bindings/validation-engine/src"],
      "@bindings/counter": ["src/bindings/protected-counter/src"]
    }
  },
  "include": ["src"],
  "exclude": ["src/bindings/**/node_modules", "src/bindings/**/dist"]
}
