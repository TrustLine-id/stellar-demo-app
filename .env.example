VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_NETWORK=TESTNET

# Trustline Registry (oracles + sanctions keys)
VITE_REGISTRY_CONTRACT_ID=

# Shared TrustlineOracleVE (both tabs)
VITE_VE_CONTRACT_ID=

# Tab 1 — Trustline Firewall (ownership / firewall)
VITE_FIREWALL_CONTRACT_ID=
VITE_COUNTER_CONTRACT_ID=

# Tab 2 — Payment Forwarder (direct SDK)
VITE_PAYMENT_FORWARDER_CONTRACT_ID=
VITE_NATIVE_TOKEN_ID=

# Trustline WebSDK (@trustline.id/websdk) — client id from the Trustline dashboard
# (not required for Web3 integration)
VITE_TRUSTLINE_CLIENT_ID=PLACEHOLDER_TRUSTLINE_CLIENT_ID
# Stellar Trustline chain id: 1=mainnet, 2=testnet, 3=futurenet
VITE_BACKEND_CHAIN_ID=2
