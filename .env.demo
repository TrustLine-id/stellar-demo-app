# Pre-deployed Soroban testnet stack for the Trustline demo (shared demo contracts).
# Copy to .env to run the UI without redeploying:
#   cp .env.demo .env

VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_NETWORK=TESTNET

# Trustline Registry (oracles + sanctions keys)
VITE_REGISTRY_CONTRACT_ID=CAOQSLSB4LGPE4JYWTCVURE76LQC5IZUOWLU3NLELXXD6ATNV6B6LHRT

# Shared TrustlineOracleVE (both tabs)
VITE_VE_CONTRACT_ID=CD6QC5KJCZLOFPQZC2FBDALM7N532PNUUUOX2Z44A5HM2SIALE77V27D

# Tab 1 — Trustline Firewall (Simple Counter)
VITE_FIREWALL_CONTRACT_ID=CCO5Q3GFRWD2JYETCJK7NC4FXJWTFIAWURRHLKVXA7DB442MKV46GAJH
VITE_COUNTER_CONTRACT_ID=CCPV2FDN2QKGAZ25BLIIZADRS7RNAIALAISWJO5A6CWD6KK2E3O5BGIM

# Tab 2 — Payment Forwarder (direct SDK)
VITE_PAYMENT_FORWARDER_CONTRACT_ID=CCWFWRV4PD42KPGYBBB3WCDH64WLF52JWPSFZEDZ42H2ZIEJODD4VQ3N
VITE_NATIVE_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Trustline WebSDK (@trustline.id/websdk) — client id from the Trustline dashboard
# (not required for Web3 integration)
VITE_TRUSTLINE_CLIENT_ID=PLACEHOLDER_TRUSTLINE_CLIENT_ID
# Stellar Trustline chain id: 1=mainnet, 2=testnet, 3=futurenet
VITE_BACKEND_CHAIN_ID=2
